{
  "name": "txt2img-sd15",
  "version": "1.1.0",
  "description": "SD1.5 txt2img, 8 steps, heun (challenger for gate demo)",
  "models": [
    {
      "type": "checkpoint",
      "name": "v1-5-pruned-emaonly.safetensors"
    }
  ],
  "workflow": {
    "4": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "v1-5-pruned-emaonly.safetensors"
      }
    },
    "6": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "{{PROMPT}}",
        "clip": [
          "4",
          1
        ]
      }
    },
    "7": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "blurry, low quality, deformed, ugly",
        "clip": [
          "4",
          1
        ]
      }
    },
    "5": {
      "class_type": "EmptyLatentImage",
      "inputs": {
        "width": 512,
        "height": 512,
        "batch_size": 1
      }
    },
    "3": {
      "class_type": "KSampler",
      "inputs": {
        "model": [
          "4",
          0
        ],
        "positive": [
          "6",
          0
        ],
        "negative": [
          "7",
          0
        ],
        "latent_image": [
          "5",
          0
        ],
        "seed": 0,
        "steps": 8,
        "cfg": 7.0,
        "sampler_name": "heun",
        "scheduler": "normal",
        "denoise": 1.0
      }
    },
    "8": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "3",
          0
        ],
        "vae": [
          "4",
          2
        ]
      }
    },
    "9": {
      "class_type": "SaveImage",
      "inputs": {
        "images": [
          "8",
          0
        ],
        "filename_prefix": "comfyops"
      }
    }
  }
}